<footer class="container supports">
<h2 class="title">{{support.title1}}<br/>{{support.title2}}.</h2>
<p class="text-download">{{support.text}}, <span class="mono neons">{{support.run}}</span>, {{support.text1}}</p>
<h3>{{support.info}}</h3>
<div class="row mt-5">
<div class="col-lg-4 col-12">
<a href="{{support.paypal.url}}" class="glow-btn mono mt-1 mb-1 btn-download">{{support.paypal.text}} →</a>
</div>
<div class="col-lg-4 col-12">
<a href="{{support.gumroad.url}}" class="glow-btn mono btn-premium">{{support.gumroad.text}} →</a>
</div>
<div class="col-lg-4 col-12">
<a href="{{support.github.url}}" class="glow-btn mono mt-1 mb-1 btn-download">{{support.github.text}} →</a>
</div>
</div>
<div class="mono" style="margin-top:24px;font-size:11px;opacity:0.4;letter-spacing:2px">PURE C# • 0 DEPS • CMD NATIVE • BLAZOR KILLER</div>
</footer>