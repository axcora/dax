<section class="container download" id="download">
<h2 class="title"><a href="{{metadata.url}}" class="text-white">
{{download.title}}</a></h2>
<p class="text-download">{{download.description}}</p>
<div class="download-section">
<div class="glass p-20">
  <div class="mono info">{{download.starter.info}}</div>
<h3 class="mt-3">
  <a href="{{metadata.url}}" class="text-white">
    {{download.starter.title}}</a></h3>
<p class="texts">
  {{download.starter.text}}
</p>
<pre class="mt-3">git clone https://github.com/mesinkasir/dax.git
cd dax
dotnet publish -c Release -o .
dax build   // 11 pages 127ms
dax start   // localhost:8080
</pre>
<p class="texts">{{download.starter.text2}}</p>
<a href="{{download.starter.button.url}}" class="glow-btn mt-5 mono btn-download">{{download.starter.button.text}} →</a></div>

<div class="glass premium">
  <div class="mono premium-info">{{download.premium.info}}</div>
  <h3 class="mt-1">
  <a href="{{metadata.url}}" class="text-white">
    {{download.premium.title}}</a></h3>
    <img src="{{download.premium.image}}" loading="lazy" 
    width="100%" height="100%" 
    alt="{{download.premium.title}}" 
    class="img-fluid mt-2"/>
  <p class="texts mb-3">
  {{download.premium.text}}
  </p>
<a href="{{download.premium.button.url}}" class="glow-btn mono btn-premium">{{download.premium.button.text}} →</a>
<a href="{{download.premium.button2.url}}" class="glow-btn mt-2 mono btn-download">{{download.premium.button2.text}} →</a></div>
</div>

<div class="mono text-intro">PURE C# • 0 DEPS • MIT • RESPONSIVE • NO WASM</div>
</section>
